# Copia a .env y rellena con tus valores

# ===== App (Spring) =====
DATABASE_URL=jdbc:postgresql://localhost:5432/fitness
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme
ALLOWED_ORIGINS=http://localhost:4200

# Opcionales (defaults en application.properties)
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false

# ===== Docker Compose (despliegue VPS) =====
# Las usa docker-compose.yml para crear Postgres y conectar la app.
# Dentro de compose, DATABASE_URL se construye con el host "db":
#   jdbc:postgresql://db:5432/${POSTGRES_DB}
POSTGRES_DB=fitness
POSTGRES_USER=powerlab
POSTGRES_PASSWORD=changeme
